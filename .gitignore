node_modules
dist
staff-app/dist
server/data.db
server/data.db-shm
server/data.db-wal
server/storage/tts/
# Item photos are runtime uploads referenced by items.image_path, and the
# database holding those paths is ignored too, so they are deployment state
# rather than source.
server/storage/item-images/
android/
# esbuild temp chunks emitted by the staff vite config
staff-app/vite.config.ts.timestamp-*.mjs

# TypeScript incremental build artefacts
*.tsbuildinfo

# Per-machine hardware config: the scale port and PLC IP a given machine last
# connected with. Like data.db, this is deployment state, not source - it must
# never be copied between machines or baked into a fresh checkout.
server/scale-config.json
server/plc-config.json

# Python bytecode from the windows kiosk lock
scripts/__pycache__/
*.pyc
